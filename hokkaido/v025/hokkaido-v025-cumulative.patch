+// SPDX-FileCopyrightText: 2026 OpenAI-assisted analysis, adapted from Eden-Bounded concepts
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cstdint>
+
+namespace VideoCommon::AndroidMemoryPolicy {
+constexpr uint64_t MiB = uint64_t{1} << 20;
+
+// Budget policy only: does not destroy GPU objects, touch page mappings, or force a
+// lower guest memory layout.  The existing Vulkan texture collector remains the
+// sole owner of reclamation and deferred GPU resource destruction.
+[[nodiscard]] constexpr uint64_t ReserveBytes(uint64_t available, uint64_t swap_total,
+                                               uint64_t swap_free) noexcept {
+    constexpr uint64_t Base = 768 * MiB;
+    constexpr uint64_t MaximumExtra = 768 * MiB;
+    uint64_t extra = 0;
+    if (swap_total != 0) {
+        swap_free = (std::min)(swap_free, swap_total);
+        // Begin responding at 25% swap use, before Android LMKD's emergency.
+        const uint64_t used = swap_total - swap_free;
+        if (used > swap_total / 4) {
+            extra = (std::min)((used - swap_total / 4) / 2, 512 * MiB);
+        }
+    }
+    if (available < 1536 * MiB) {
+        const uint64_t shortage = 1536 * MiB - available;
+        extra = (std::min)(MaximumExtra, extra + (std::min)(shortage / 2, 512 * MiB));
+    }
+    return Base + extra;
+}
+
+// Non-destructive upper bound for GPU budget.  Never reports less than current
+// GPU allocation usage: the renderer must be able to retire allocations itself.
+[[nodiscard]] constexpr uint64_t RemainingBudget(uint64_t usage, uint64_t available,
+                                                  uint64_t swap_total, uint64_t swap_free) noexcept {
+    const uint64_t reserve = ReserveBytes(available, swap_total, swap_free);
+    const uint64_t slack = available > reserve ? available - reserve : 0;
+    // Saturate rather than wrapping near UINT64_MAX.
+    return UINT64_MAX - usage < slack ? UINT64_MAX : usage + slack;
+}
+} // namespace VideoCommon::AndroidMemoryPolicy
