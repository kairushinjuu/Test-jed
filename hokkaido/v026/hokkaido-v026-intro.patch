+// SPDX-License-Identifier: GPL-3.0-or-later
+// Hokkaido experimental Ocarina opening cinematic skip policy (opt-in).
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <string_view>
+
+namespace Service::Nx2IntroSkip {
+
+inline constexpr uint64_t OcarinaProgramId = UINT64_C(0x0400486024DEC000);
+
+inline bool IsAv1(std::string_view codec) {
+    return codec == "video/av1" || codec.starts_with("video/av01");
+}
+
+inline bool Requested(const char* value) {
+    return value && value[0] == '1' && value[1] == '\0';
+}
+
+// Avoid skipping all movies: only the first AV1 decoder configured for Ocarina per process.
+// This is an experiment: only a device run can prove the guest reacts to synthetic EOS.
+class Session {
+public:
+    bool Configure(uint64_t program, std::string_view codec, const char* opt,
+                   std::atomic<bool>& claimed) {
+        active = false;
+        output_queued = false;
+        packets_ignored = 0;
+        if (program != OcarinaProgramId || !IsAv1(codec) || !Requested(opt)) {
+            return false;
+        }
+        bool expected = false;
+        active = claimed.compare_exchange_strong(expected, true);
+        return active;
+    }
+
+    // Returns true if the compressed packet is intentionally not decoded. Exactly one
+    // synthetic EOS is queued. Subsequent packets are accepted without new output.
+    bool AcceptPacket(bool& queue_eos) {
+        queue_eos = false;
+        if (!active) return false;
+        queue_eos = !output_queued;
+        output_queued = true;
+        ++packets_ignored;
+        return true;
+    }
+
+    void Stop() { active = false; output_queued = false; }
+    bool Active() const { return active; }
+    uint64_t PacketsIgnored() const { return packets_ignored; }
+
+private:
+    bool active{};
+    bool output_queued{};
+    uint64_t packets_ignored{};
+};
+
+} // namespace Service::Nx2IntroSkip
